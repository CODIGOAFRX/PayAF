<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.pedrogomez.payaf</groupId>
    <artifactId>payaf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PayAF</name>
    <description>Enrutador de pagos multi-PSP con failover (arquitectura hexagonal)</description>

    <modules>
        <module>payaf-domain</module>
        <module>payaf-application</module>
        <module>payaf-adapters</module>
        <module>payaf-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.2.0</spring-boot.version>
        <!-- Alineadas con las que gestiona el BOM de Spring Boot 4.2.0 -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.5.1</archunit.version>
        <picocli.version>4.7.7</picocli.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Módulos propios -->
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-in-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-in-webhook</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-in-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-out-gateway-sim</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-out-persistence-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-out-persistence-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pedrogomez.payaf</groupId>
                <artifactId>payaf-adapter-out-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Versiones de test fijadas antes que el BOM de Spring Boot para que manden ellas -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>

            <!-- BOM de Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
