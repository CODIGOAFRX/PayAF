<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pedrogomez.payaf</groupId>
        <artifactId>payaf-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>payaf-bootstrap</artifactId>
    <name>PayAF :: Bootstrap</name>
    <description>Aplicación Spring Boot: el único sitio donde se cablean los adaptadores</description>

    <dependencies>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-application</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-in-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-in-webhook</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-in-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-out-gateway-sim</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-out-persistence-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-out-persistence-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pedrogomez.payaf</groupId>
            <artifactId>payaf-adapter-out-outbox</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
